# [自訂] S55：本 fork 一律使用官方 npm registry，不經任何鏡像。
# replace-registry-host=always：即使 package-lock.json 之後又被寫入其他主機，
# 安裝時也一律改向下面的 registry 下載。
registry=https://registry.npmjs.org/
replace-registry-host=always
# [自訂] SC-23（L-85、L-86）：npm 不把依賴清單送去 audit、不查自己的新版本、不顯示 fund 訊息。
audit=false
fund=false
update-notifier=false
