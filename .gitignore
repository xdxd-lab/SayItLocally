!client/scripts/macos/
client/dist/
# build.rs 從 transcribe-cpp 的構建產物拷進來的 DLL，純生成物
client/src-tauri/transcribe-libs/

# ── Kiro IDE ──
.kiro/

# ── Claude Code ──
CLAUDE.md
.claude/
.agents/

# ── Node ──
node_modules/

# ── Rust build output ──
target/
# 應用在跑時它鎖著 target/debug 裡的 ggml DLL，cargo 會報 os error 32；
# 換個 target 目錄編譯是繞過它的標準做法（pitfalls #4），別讓產物進倉庫。
target-check/

# ── Python ──
__pycache__/
*.pyc
.venv*/

# ── OS ──
.DS_Store
Thumbs.db

# ── IDE ──
.vscode/
.idea/

# ── Tauri dev artifacts ──
*.blockmap

# ── Logs & runtime ──
*.log
runtime/

# macOS 釋出產物（scripts/macos/build-release.sh）
client/dist-macos/
